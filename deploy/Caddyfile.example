# Small Party World — Caddy 설정
# 기존 Caddyfile에 아래 두 블록을 추가(기존 spw.cloudish.cloud 블록은 교체)한 뒤 reload 하세요.
#   Caddy를 Ubuntu에 직접 설치: sudo systemctl reload caddy
#   Caddy가 Docker 컨테이너:   docker exec <caddy컨테이너> caddy reload --config /etc/caddy/Caddyfile

# ---------------------------------------------------------------
# 1) 게임 서버 (중계 서버) — spwsv.cloudish.cloud
#    WebSocket(게임 접속) → 7777 / 그 외(브라우저) → 7778 상태 페이지
# ---------------------------------------------------------------
spwsv.cloudish.cloud {
	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @websocket {
		reverse_proxy 127.0.0.1:7777 {
			# reload 할 때 진행 중인 게임 연결이 바로 끊기지 않게
			stream_close_delay 10m
		}
	}
	handle {
		reverse_proxy 127.0.0.1:7778
	}
}

# ---------------------------------------------------------------
# 2) 웹 게임 플레이 페이지 — spw.cloudish.cloud
#    Godot 웹 빌드 결과물(index.html, .wasm, .pck, .js)을 아래 폴더에 두면 됩니다.
#    웹 빌드 전까지는 deploy/web-placeholder/index.html 을 넣어 두세요.
# ---------------------------------------------------------------
spw.cloudish.cloud {
	encode zstd gzip
	# 관리 페이지·공지 API → 관리 서버 컨테이너 (127.0.0.1:7780)
	@admin path /admin /admin/* /api/*
	handle @admin {
		reverse_proxy 127.0.0.1:7780
	}
	handle {
		root * /srv/small_party_world/web
		# 업데이트 직후 옛 파일이 캐시에 남아 버전이 섞이지 않게
		@nocache path *.html *.js *.pck *.json
		header @nocache Cache-Control "no-cache"
		file_server
	}
	# 웹 빌드에서 '스레드 지원'을 켠 경우에만 필요 (끈 빌드는 불필요):
	# header {
	# 	Cross-Origin-Opener-Policy same-origin
	# 	Cross-Origin-Embedder-Policy require-corp
	# }
}

# Caddy가 Docker 컨테이너이고 게임 서버와 같은 Docker 네트워크에 있다면
# 127.0.0.1 대신 컨테이너 이름을 쓰세요:
#   reverse_proxy small-party-world-server:7777   /   reverse_proxy small-party-world-server:7778
#   reverse_proxy small-party-world-admin:7780
# 웹 파일 폴더(/srv/small_party_world/web)도 Caddy 컨테이너에 볼륨으로 마운트해야 합니다.
